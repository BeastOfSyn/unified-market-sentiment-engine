# Database Configuration
# Use postgresql+asyncpg for SQLAlchemy async PostgreSQL support
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/insightbridge

# FastAPI Server Settings
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Reddit API Configuration (Simulation values can be used if offline)
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=insightbridge:v1.0 (by /u/username)
